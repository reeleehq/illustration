          "title": "Audio Policy"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "author_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
