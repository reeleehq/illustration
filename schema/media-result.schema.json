  "discriminator": {
    "mapping": {
      "image": "#/$defs/ImageResult",
      "video": "#/$defs/VideoResult"
    },
    "propertyName": "media_type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ImageResult"
    },
    {
      "$ref": "#/$defs/VideoResult"
    }
  ],
  "title": "MediaResult"
