{
  "$defs": {
    "ImageResult": {
      "description": "One normalized image hit from any provider.\n\nThe first eight fields plus ``cacheable`` are the cross-provider minimum the\ndesign guarantees; the rest are populated when a provider supplies them.",
      "properties": {
        "attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ready-to-render attribution sentence.",
          "title": "Attribution"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "author_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author Url"
        },
        "avg_color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dominant-color hint where available.",
          "title": "Avg Color"
        },
        "cacheable": {
          "default": false,
          "description": "May the bytes be downloaded/cached to our server?",
          "title": "Cacheable",
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Alt text / longer description.",
          "title": "Description"
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "id": {
          "description": "Provider-native identifier.",
          "title": "Id",
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "License code or name (e.g. 'by-sa').",
          "title": "License"
        },
        "license_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Url"
        },
        "media_type": {
          "const": "image",
          "default": "image",
          "type": "string"
        },
        "provider": {
          "description": "Source/provider name, e.g. 'openverse'.",
          "title": "Provider",
          "type": "string"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Canonical query that produced this hit.",
          "title": "Query"
        },
        "raw": {
          "additionalProperties": true,
          "default": {},
          "description": "Untranslated provider payload.",
          "title": "Raw",
          "type": "object"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reserved for Layer-2 rerank; None at Layer 1.",
          "title": "Score"
        },
        "source_page_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Page Url"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "thumbnail_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thumbnail Url"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "url": {
          "description": "Full-resolution image URL.",
          "title": "Url",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
