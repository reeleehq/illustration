    "TimeSpan": {
      "description": "A span of a media file, in seconds.\n\nMaps onto an OTIO ``TimeRange``, a schema.org ``Clip`` and a media-fragment\n``#t=start,end``.",
      "properties": {
        "end": {
          "title": "End",
          "type": "number"
        },
        "start": {
          "title": "Start",
          "type": "number"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeSpan",
      "type": "object"
    },
    "VideoResult": {
      "description": "One normalized video hit from any provider.\n\nCarries the :class:`MediaResult` fields plus what is specific to footage.\n``url`` stays the best *progressive* rendition at search time, so a reader\nof ``.url`` keeps working; ``renditions`` lists every encoding on offer.\n\nThe four :data:`VIDEO_RIGHTS_FIELDS` are optional; ``None`` means *not\nrecorded*.",
      "properties": {
        "attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ready-to-render attribution sentence.",
          "title": "Attribution"
        },
        "audio_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
