        "avg_color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dominant-color hint where available.",
          "title": "Avg Color"
        },
        "cacheable": {
          "default": false,
          "description": "May the bytes be downloaded/cached to our server?",
          "title": "Cacheable",
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Alt text / longer description.",
          "title": "Description"
        },
        "duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
